# ==============================
# Database - Local Windows MySQL
# ==============================
POPQ_DB_NAME=popq
POPQ_DB_URL=jdbc:mysql://localhost:3306/popq?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
POPQ_DB_PORT=3306
POPQ_DB_USERNAME=root
POPQ_DB_PASSWORD=1234
POPQ_DB_ROOT_PASSWORD=1234

# ==============================
# Spring Boot
# ==============================
POPQ_SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=dev
POPQ_SPRING_PROFILES_ACTIVE=dev

# ==============================
# Web ports
# ==============================
POPQ_QR_WEB_PORT=5173
POPQ_SELLER_WEB_PORT=5174

# ==============================
# JWT
# ==============================
POPQ_JWT_ISSUER=popq
POPQ_JWT_SECRET=popq-local-jwt-secret-key-2026-abcdef
POPQ_ACCESS_TOKEN_EXPIRATION=PT1H

# ==============================
# Development authentication
# ==============================
POPQ_DEV_LOGIN_ENABLED=true

# ==============================
# Upload
# ==============================
POPQ_UPLOAD_PATH=./uploads

# ==============================
# QR / Guest session
# ==============================
POPQ_QR_PUBLIC_BASE_URL=http://localhost:5173
POPQ_GUEST_SESSION_TTL=PT12H
POPQ_COOKIE_SECURE=false

# ==============================
# Order
# ==============================
POPQ_ORDER_PAYMENT_DEADLINE=PT15M

# ==============================
# CORS / WebSocket
# ==============================
POPQ_REALTIME_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
POPQ_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174